# Tingfinder uses native Kept authentication, per owner decision 2026-11-25.
# Keep the old origin serving the app so existing offline queues can sync.
http://tingfinder.laugesbin.win:18600, http://dev-kept.laugesbin.win:18600 {
	bind 127.0.0.1
	import security
	header >Cache-Control "private, no-store"
	route {
		respond /_device/verify 404
		# Retired device login/onboarding links must not expose a private invitation.
		@retired path /_device/* /api/preview-start /start
		redir @retired /signin 303
		reverse_proxy 127.0.0.1:18740 {
			header_up Host {host}
			header_up X-Forwarded-Proto https
			header_up -Authorization
			header_up -X-Device-Verify
		}
	}
}
